{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "data/**/*.ts", "server/**/*.ts", "mcp/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
